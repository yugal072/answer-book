# Provider-neutral model configuration. Choose a provider and model separately for each role.
# Supported chat providers: groq, gemini (Google AI Studio), openai, openai_compatible.
# Qwen can run via Groq (provider=groq, model=the Groq-hosted Qwen ID) or an
# OpenAI-compatible Qwen/DashScope endpoint (provider=openai_compatible).

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

LLM_DEFAULT_PROVIDER=groq
LLM_CHEAP_PROVIDER=groq
LLM_STANDARD_PROVIDER=groq
LLM_REASONING_PROVIDER=groq
LLM_PLANNER_PROVIDER=groq
LLM_VERIFIER_PROVIDER=groq
LLM_VISION_PROVIDER=gemini
LLM_IMAGE_PROVIDER=disabled

LLM_DEFAULT_MODEL=qwen/qwen3.8-27b
LLM_CHEAP_MODEL=llama-3.1-8b-instant
LLM_STANDARD_MODEL=qwen/qwen3.8-27b
LLM_REASONING_MODEL=qwen/qwen3.8-27b
LLM_PLANNER_MODEL=llama-3.1-8b-instant
LLM_VERIFIER_MODEL=qwen/qwen3.8-27b
# Set this to a model that actually supports image input on the chosen provider.
LLM_VISION_MODEL=gemini-2.0-flash
# Image generation is a separate capability and needs a provider-specific adapter.
LLM_IMAGE_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2

DATABASE_URL=
SOLUTION_STORE_ENABLED=true
SOLUTION_CACHE_MIN_CONFIDENCE=0.90
SOLUTION_STORE_MIN_CONFIDENCE=0.90
SOLUTION_MAX_ATTEMPTS=2
SOLUTION_PROMPT_VERSION=2026-10-v1
